{% extends 'settings/_layout.html.twig' %}

{% block settings_body %}
    <div class="panel-header">
        <h2 class="panel-title">Ebooks</h2>
    </div>

    <p class="form-note">
        Where finished ebooks land and how their files are named — applied whether the book
        arrived by direct download or by torrent. The channels themselves are configured on the
        <a href="{{ path('settings_direct_download') }}">Direct Downloads</a> and
        <a href="{{ path('settings_torrents') }}">Torrents</a> tabs; source ordering lives under
        <a href="{{ path('settings_general') }}">Settings → General → Source priority</a>.
    </p>

    <form method="post" action="{{ path('settings_ebooks') }}" class="settings-form" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('settings_ebooks') }}">

        <fieldset class="settings-fieldset">
            <legend>Output</legend>
            <div class="field">
                <label for="outputDirectory">Ebook library / watch folder</label>
                <input type="text" id="outputDirectory" name="outputDirectory" value="{{ output_directory }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="/library/import">
                <p class="form-note">
                    Absolute path a finished ebook is moved into — point this at the folder your
                    library (e.g. Komga) watches, so the book is imported and the request flips to
                    Available. The worker container must have this path mounted and writable.
                </p>
            </div>
            <div class="field">
                <label for="filenameTemplate">Ebook filename template</label>
                <input type="text" id="filenameTemplate" name="filenameTemplate" value="{{ filename_template }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="{{ '{Author} - {Title} ({Year})' }}">
                <p class="form-note">
                    Tokens: <code>{{ '{Author}' }}</code>, <code>{{ '{Title}' }}</code>,
                    <code>{{ '{Year}' }}</code>, <code>{{ '{ISBN}' }}</code>, <code>{{ '{Format}' }}</code>.
                    The file extension is appended automatically. Empty tokens and any surrounding empty
                    brackets are cleaned up. Names the ebook <em>file</em> — not the audiobook album
                    folder, which has its own template on the
                    <a href="{{ path('settings_audiobooks') }}">Audiobooks</a> tab.
                </p>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save settings</button>
        </div>
    </form>
{% endblock %}
