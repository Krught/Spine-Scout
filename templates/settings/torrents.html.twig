{% extends 'settings/_layout.html.twig' %}

{% block settings_body %}
    <div class="panel-header">
        <h2 class="panel-title">Torrents</h2>
    </div>

    <p class="form-note">
        Books and audiobooks can be fulfilled over BitTorrent. Configure your <strong>indexers</strong>
        and a <strong>download client</strong> below, then turn on torrenting per format: audiobooks use
        it automatically, and for books you add/order <strong>Torrent</strong> in
        <a href="{{ path('settings_general') }}">Settings → General → Source priority</a>.
        Spine Scout searches your indexers, sends the best match to the download client, then moves the
        finished files into your library. Ebook delivery (library folder, file naming) is configured on
        the <a href="{{ path('settings_ebooks') }}">Ebooks</a> tab; audiobook delivery (destination
        folders, naming, metadata sidecars) on the
        <a href="{{ path('settings_audiobooks') }}">Audiobooks</a> tab.
    </p>

    <form method="post" action="{{ path('settings_torrents') }}" class="settings-form" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('settings_torrents') }}">

        {# -- Indexers ------------------------------------------------------------ #}
        <fieldset class="settings-fieldset">
            <legend>Indexers</legend>
            {% if prowlarr.id is not null %}
                <div class="status-pill {{ prowlarr.enabled ? 'status-pill-on' : 'status-pill-off' }}">
                    <span class="dot"></span>
                    {{ prowlarr.enabled ? 'Enabled' : 'Disabled' }}
                    {% if prowlarr.lastError %}· <span class="status-error">Last error: {{ prowlarr.lastError }}</span>{% endif %}
                </div>
            {% endif %}
            <label class="field-checkbox">
                <input type="checkbox" name="prowlarr_enabled" value="1" {{ prowlarr.enabled ? 'checked' : '' }}>
                <span>Enable torrent search</span>
            </label>
            <div class="field">
                <label for="prowlarr_base_url">Indexer manager URL</label>
                <input type="text" id="prowlarr_base_url" name="prowlarr_base_url" value="{{ prowlarr.baseUrl }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="http://your-indexer-host:9696">
            </div>
            <div class="field">
                <label for="prowlarr_api_key">API key</label>
                <input type="password" id="prowlarr_api_key" name="prowlarr_api_key" value=""
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="{{ prowlarr.hasCredentials ? 'Leave blank to keep current key' : 'Indexer manager API key' }}">
            </div>
            <div class="field">
                <label for="prowlarr_categories">Audiobook categories</label>
                <input type="text" id="prowlarr_categories" name="prowlarr_categories"
                       value="{{ prowlarr_config.categories|join(', ') }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="3030">
                <p class="form-note">Comma-separated Torznab category numbers for audiobook searches. Default <code>3030</code> (Audio/Audiobook); leave blank for the default.</p>
            </div>
            <div class="field">
                <label for="prowlarr_book_categories">Book categories</label>
                <input type="text" id="prowlarr_book_categories" name="prowlarr_book_categories"
                       value="{{ prowlarr_config.bookCategories|join(', ') }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="7000, 7020">
                <p class="form-note">Comma-separated Torznab category numbers for book searches. Default <code>7000, 7020</code> (Books, Books/EBook); leave blank for the default.</p>
            </div>
            <div class="field">
                <label for="prowlarr_search_method">Search method</label>
                <select id="prowlarr_search_method" name="prowlarr_search_method">
                    <option value="categories" {{ prowlarr_config.searchMethod == 'categories' ? 'selected' : '' }}>Category filter — send the Torznab categories with the query</option>
                    <option value="raw" {{ prowlarr_config.searchMethod == 'raw' ? 'selected' : '' }}>Raw — no category filter, show everything</option>
                    <option value="filtered" {{ prowlarr_config.searchMethod == 'filtered' ? 'selected' : '' }}>Post-search filter — raw query, then drop wrong-type releases</option>
                </select>
                <p class="form-note">
                    Some indexers ignore or mis-map category filters and return nothing under
                    <em>Category filter</em>. <em>Raw</em> queries without a category scope;
                    <em>Post-search filter</em> does the same, then removes results the app can tell are
                    the wrong kind (ebook vs audiobook) from their categories or file format.
                    This is the default for automatic fulfillment; the interactive search panel can
                    override it per search.
                </p>
            </div>
            <div class="field" data-controller="connection-test"
                 data-connection-test-url-value="{{ path('settings_torrents_test_prowlarr') }}"
                 data-connection-test-token-value="{{ csrf_token('settings_torrents_test') }}">
                <button type="button" class="btn" data-connection-test-target="button" data-action="connection-test#run">Test connection</button>
                <p class="form-note" data-connection-test-target="result" hidden></p>
                <p class="form-note">Tests the saved settings — save first if you just changed them.</p>
            </div>
        </fieldset>

        {# -- Matching ------------------------------------------------------------ #}
        <fieldset class="settings-fieldset">
            <legend>Match criteria</legend>
            <p class="form-note">
                Among the search results, releases below the seed floor (or above the size cap) are
                discarded, and the rest are ranked by a weighted score. Higher weight = more influence.
            </p>
            <p class="form-note">
                These are indexer pre-filters, applied to torrent search results before scoring. The
                quality gates that judge the final cross-source pick (size, seeders, match score) live
                on the <a href="{{ path('settings_best_match') }}">Best match</a> tab.
            </p>
            <div class="field">
                <label for="prowlarr_min_seeders">Minimum seeders</label>
                <input type="number" id="prowlarr_min_seeders" name="prowlarr_min_seeders" min="0" step="1"
                       value="{{ prowlarr_config.minSeeders }}">
            </div>
            <div class="field">
                <label for="prowlarr_max_size_gb">Maximum size (GB, optional)</label>
                <input type="number" id="prowlarr_max_size_gb" name="prowlarr_max_size_gb" min="0" step="0.1"
                       value="{{ prowlarr_config.maxSizeBytes ? (prowlarr_config.maxSizeBytes / (1024*1024*1024))|round(2) : '' }}"
                       placeholder="no cap">
            </div>
            <div class="field-grid">
                <div class="field">
                    <label for="prowlarr_weight_match">Weight: title/author match</label>
                    <input type="number" id="prowlarr_weight_match" name="prowlarr_weight_match" min="0" step="0.05"
                           value="{{ prowlarr_config.weights.match }}">
                </div>
                <div class="field">
                    <label for="prowlarr_weight_seeders">Weight: seeders</label>
                    <input type="number" id="prowlarr_weight_seeders" name="prowlarr_weight_seeders" min="0" step="0.05"
                           value="{{ prowlarr_config.weights.seeders }}">
                </div>
                <div class="field">
                    <label for="prowlarr_weight_size">Weight: size</label>
                    <input type="number" id="prowlarr_weight_size" name="prowlarr_weight_size" min="0" step="0.05"
                           value="{{ prowlarr_config.weights.size }}">
                </div>
                <div class="field">
                    <label for="prowlarr_weight_format">Weight: format</label>
                    <input type="number" id="prowlarr_weight_format" name="prowlarr_weight_format" min="0" step="0.05"
                           value="{{ prowlarr_config.weights.format }}">
                </div>
            </div>
        </fieldset>

        {# -- Download client ----------------------------------------------------- #}
        <fieldset class="settings-fieldset">
            <legend>Download Client</legend>
            {% if qbittorrent.id is not null %}
                <div class="status-pill {{ qbittorrent.enabled ? 'status-pill-on' : 'status-pill-off' }}">
                    <span class="dot"></span>
                    {{ qbittorrent.enabled ? 'Enabled' : 'Disabled' }}
                    {% if qbittorrent.lastError %}· <span class="status-error">Last error: {{ qbittorrent.lastError }}</span>{% endif %}
                </div>
            {% endif %}
            <label class="field-checkbox">
                <input type="checkbox" name="qbittorrent_enabled" value="1" {{ qbittorrent.enabled ? 'checked' : '' }}>
                <span>Enable download client</span>
            </label>
            <div class="field">
                <label for="qbittorrent_base_url">Download client URL</label>
                <input type="text" id="qbittorrent_base_url" name="qbittorrent_base_url" value="{{ qbittorrent.baseUrl }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off" placeholder="http://your-download-host:8080">
            </div>
            <div class="field">
                <label>Authentication</label>
                <label class="field-checkbox">
                    <input type="radio" name="qbittorrent_auth_method" value="basic"
                           {{ qbittorrent.authType == 'api_key' ? '' : 'checked' }}>
                    <span>Username / password</span>
                </label>
                <label class="field-checkbox">
                    <input type="radio" name="qbittorrent_auth_method" value="api_key"
                           {{ qbittorrent.authType == 'api_key' ? 'checked' : '' }}>
                    <span>API key</span>
                </label>
            </div>
            <div class="field-grid qb-auth-basic">
                <div class="field">
                    <label for="qbittorrent_username">Username</label>
                    <input type="text" id="qbittorrent_username" name="qbittorrent_username"
                           value="{{ qbittorrent.credentials.username ?? '' }}"
                           spellcheck="false" autocapitalize="off" autocomplete="off">
                </div>
                <div class="field">
                    <label for="qbittorrent_password">Password</label>
                    <input type="password" id="qbittorrent_password" name="qbittorrent_password" value=""
                           spellcheck="false" autocapitalize="off" autocomplete="off"
                           placeholder="{{ qbittorrent.credentials.password is defined ? 'Leave blank to keep current' : '' }}">
                </div>
            </div>
            <div class="field qb-auth-api-key">
                <label for="qbittorrent_api_key">API key</label>
                <input type="password" id="qbittorrent_api_key" name="qbittorrent_api_key" value=""
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="{{ qbittorrent.credentials.api_key is defined ? 'Leave blank to keep current key' : 'qbt_…' }}">
                <p class="form-note">
                    Requires qBittorrent 5.2.0 or newer. Generate the key in qBittorrent under
                    Options → Web UI → API key; it is sent as an <code>Authorization: Bearer</code>
                    header and no username/password login is performed.
                </p>
            </div>
            <style>
                /* No-JS toggle: hide whichever credential block the selected auth method
                   doesn't use. Browsers without :has() show both — harmless, since blank
                   fields keep the stored values. */
                fieldset:has(input[name="qbittorrent_auth_method"][value="api_key"]:checked) .qb-auth-basic,
                fieldset:has(input[name="qbittorrent_auth_method"][value="basic"]:checked) .qb-auth-api-key {
                    display: none;
                }
            </style>
            <div class="field">
                <label for="qbittorrent_category">Category</label>
                <input type="text" id="qbittorrent_category" name="qbittorrent_category" value="{{ client_config.category }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="spinescout">
                <p class="form-note">Applied to torrents Spine Scout adds, so you can isolate them in your client.</p>
            </div>
            <p class="form-note">
                <strong>Required mount:</strong> bind-mount your download client's completed-downloads folder
                into the Spine Scout containers at <code>/downloads</code>. Spine Scout reads a finished
                torrent from <code>/downloads/&lt;torrent name&gt;</code>, so no path mapping is needed — it
                works regardless of where the client stores files on its own host. See the README for an example.
            </p>
            <div class="field" data-controller="connection-test"
                 data-connection-test-url-value="{{ path('settings_torrents_test_qbittorrent') }}"
                 data-connection-test-token-value="{{ csrf_token('settings_torrents_test') }}">
                <button type="button" class="btn" data-connection-test-target="button" data-action="connection-test#run">Test connection</button>
                <p class="form-note" data-connection-test-target="result" hidden></p>
                <p class="form-note">Tests the saved settings — save first if you just changed them.</p>
            </div>
        </fieldset>

        {# -- Seeding & cleanup --------------------------------------------------- #}
        <fieldset class="settings-fieldset">
            <legend>Seeding &amp; cleanup</legend>
            <label class="field-checkbox">
                <input type="checkbox" name="remove_on_complete" value="1" {{ client_config.removeOnComplete ? 'checked' : '' }}>
                <span>Remove the torrent and delete its original files after import</span>
            </label>
            <p class="form-note">
                Once the import lands in your library, remove the finished torrent from qBittorrent and delete
                the files it downloaded. Untick to keep seeding (e.g. on a private tracker).
            </p>
            <div class="field">
                <label for="reconcile_interval_hours">Reconcile orphaned torrents every (hours)</label>
                <input type="number" id="reconcile_interval_hours" name="reconcile_interval_hours" min="0" step="1"
                       value="{{ client_config.reconcileIntervalHours }}">
                <p class="form-note">
                    A torrent job that failed can sometimes still be present and finishing in qBittorrent (e.g.
                    after a transient connection blip). This automatically re-links such jobs back so they get
                    imported normally — no need to remove and re-add the torrent. Set to 0 to disable the
                    automatic run; the button below always works.
                    {% if qbittorrent.lastSyncAt %}
                        · Last run {{ qbittorrent.lastSyncAt|date('Y-m-d H:i') }}
                    {% endif %}
                </p>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save settings</button>
        </div>
    </form>

    <fieldset class="settings-fieldset">
        <legend>Orphaned torrents</legend>
        <p class="form-note">
            Re-links any errored torrent job whose torrent is still present in qBittorrent (e.g. after a
            transient connection blip falsely marked it removed) back into the normal download pipeline,
            so it's picked up and imported on the next poll — including torrents that already finished.
        </p>
        <form method="post" action="{{ path('settings_torrents_reconcile') }}" class="inline-form">
            <input type="hidden" name="_token" value="{{ csrf_token('torrents_reconcile') }}">
            <button type="submit" class="btn btn-secondary">Run reconcile now</button>
        </form>
    </fieldset>
{% endblock %}
