{% extends 'base.html.twig' %}

{% block title %}Settings - Spine Scout{% endblock %}

{% block body %}
    <div class="settings">
        <header class="settings-header">
            <h1>Settings</h1>
            <p>Configure Spine Scout, connect integrations, and manage users.</p>
        </header>

        <nav class="settings-tabs" aria-label="Settings sections">
            {% set tabs = [
                { id: 'general',          label: 'General',           route: 'settings_general' },
                { id: 'grimmory',         label: 'Komga',             route: 'settings_grimmory' },
                { id: 'metadata',         label: 'Metadata',          route: 'settings_metadata' },
                { id: 'direct_download',  label: 'Direct Downloads',  route: 'settings_direct_download' },
                { id: 'ebooks',           label: 'Ebooks',            route: 'settings_ebooks' },
                { id: 'audiobooks',       label: 'Audiobooks',        route: 'settings_audiobooks' },
                { id: 'torrents',         label: 'Torrents',          route: 'settings_torrents' },
                { id: 'myanonamouse',     label: 'MyAnonamouse',      route: 'settings_myanonamouse' },
                { id: 'best_match',       label: 'Best Match',        route: 'settings_best_match' },
                { id: 'blocklist',        label: 'Blocklist',         route: 'settings_blocklist' }
            ] %}
            {% for tab in tabs %}
                <a class="settings-tab{% if active_tab == tab.id %} active{% endif %}" href="{{ path(tab.route) }}">{{ tab.label }}</a>
            {% endfor %}
        </nav>

        {% for label, messages in app.flashes %}
            {% for msg in messages %}
                <div class="flash flash-{{ label }}">{{ msg }}</div>
            {% endfor %}
        {% endfor %}

        <div class="settings-panel">
            {% block settings_body %}{% endblock %}
        </div>
    </div>
{% endblock %}
