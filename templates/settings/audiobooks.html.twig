{% extends 'settings/_layout.html.twig' %}

{% block settings_body %}
    <div class="panel-header">
        <h2 class="panel-title">Audiobooks</h2>
    </div>

    <p class="form-note">
        Where finished audiobooks land and what metadata is written beside them. The torrent stack
        itself — indexers, download client, seeding policy — now lives on the
        <a href="{{ path('settings_torrents') }}">Torrents</a> tab, since it serves both audiobooks
        and ebook fallback downloads.
    </p>

    <form method="post" action="{{ path('settings_audiobooks') }}" class="settings-form" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('settings_audiobooks') }}">

        {# -- Destination --------------------------------------------------------- #}
        <fieldset class="settings-fieldset" data-controller="audio-destination">
            <legend>Audiobook destination</legend>
            <p class="form-note">Book torrents are delivered into your ebook library folder (<a href="{{ path('settings_ebooks') }}">Ebooks</a> tab). These settings apply to audiobooks.</p>
            <label class="field-checkbox">
                <input type="checkbox" name="use_ebook_library_dir" value="1" {{ client_config.useEbookLibraryDir ? 'checked' : '' }}
                       data-audio-destination-target="toggle" data-action="audio-destination#sync">
                <span>Deliver audiobooks into the ebook library folder (<code>{{ ebook_output_directory }}</code>)</span>
            </label>
            <div class="field{{ client_config.useEbookLibraryDir ? ' is-disabled' : '' }}">
                <label for="audio_output_directory">Audiobook output folder</label>
                <input type="text" id="audio_output_directory" name="audio_output_directory"
                       value="{{ client_config.audioOutputDirectory }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="/var/www/html/audiobooks"
                       data-audio-destination-target="folder"
                       {{ client_config.useEbookLibraryDir ? 'disabled' : '' }}>
                <p class="form-note">
                    Absolute path the finished audiobook is moved into — point at the folder your
                    audiobook library watches. Ignored when the checkbox above is ticked.
                </p>
            </div>
            <div class="field">
                <label for="staging_subdir">Staging sub-folder</label>
                <input type="text" id="staging_subdir" name="staging_subdir" value="{{ client_config.stagingSubdir }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="torrents">
                <p class="form-note">Under <code>var/downloads</code>; files are staged here before the final move.</p>
            </div>
            <div class="field">
                <label for="torrent_filename_template">Audiobook album folder name template</label>
                <input type="text" id="torrent_filename_template" name="torrent_filename_template"
                       value="{{ client_config.filenameTemplate }}"
                       spellcheck="false" autocapitalize="off" autocomplete="off"
                       placeholder="{{ '{Author} - {Title}' }}">
                <p class="form-note">
                    Names the album folder each finished audiobook lands in — not the ebook
                    filename template. Tokens: <code>{{ '{Author}' }}</code>,
                    <code>{{ '{Title}' }}</code>, <code>{{ '{Year}' }}</code>,
                    <code>{{ '{ISBN}' }}</code>.
                </p>
            </div>
        </fieldset>

        {# -- Metadata sidecars ---------------------------------------------------- #}
        <fieldset class="settings-fieldset">
            <legend>Metadata sidecars</legend>
            <label class="field-checkbox">
                <input type="checkbox" name="write_grimmory_sidecars" value="1" {{ client_config.writeGrimmorySidecars ? 'checked' : '' }}>
                <span>Write Grimmory metadata sidecars</span>
            </label>
            <p class="form-note">
                Writes a <code>.metadata.json</code> and <code>.cover.jpg</code> beside every finished
                audiobook download — files Grimmory can import to fill in its metadata. Disable this
                when your library server is not Grimmory; the sidecar files mean nothing to other servers.
            </p>
        </fieldset>

        {# -- Sidecar import (native API) ------------------------------------------ #}
        <fieldset class="settings-fieldset">
            <legend>Sidecar import (native API)</legend>
            <p class="form-note">
                A Grimmory user account with metadata-edit permission, used to trigger sidecar metadata
                import after each audiobook download — separate from the Komga/OPDS connection credentials
                on the <a href="{{ path('settings_grimmory') }}">Komga</a> tab.
                Leave empty if your library server is not Grimmory, or you don't want automatic imports.
                Grimmory keeps OPDS users and real user accounts in separate stores, so the connection
                credentials cannot be reused here.
            </p>

            <label class="field-checkbox">
                <input type="checkbox" name="native_sidecar_import" value="1" {{ grimmory_native.sidecarImport ? 'checked' : '' }}>
                <span>Trigger sidecar import after each download</span>
            </label>

            <div class="field-row">
                <div class="field">
                    <label for="native_username">Grimmory username</label>
                    <input type="text" id="native_username" name="native_username"
                           value="{{ grimmory_native.username }}"
                           autocomplete="off" placeholder="spinescout-metadata">
                </div>
                <div class="field">
                    <label for="native_password">Grimmory password</label>
                    <input type="password" id="native_password" name="native_password"
                           autocomplete="off"
                           placeholder="{{ grimmory_native.hasPassword ? '•••••••• (leave blank to keep current)' : '' }}">
                </div>
            </div>

            <div class="field" data-controller="connection-test"
                 data-connection-test-url-value="{{ path('settings_audiobooks_test_grimmory_native') }}"
                 data-connection-test-token-value="{{ csrf_token('settings_audiobooks_test') }}">
                <button type="button" class="btn" data-connection-test-target="button" data-action="connection-test#run">Test connection</button>
                <p class="form-note">Tests the <strong>saved</strong> credentials — save the form first.</p>
                <p class="form-note" data-connection-test-target="result" hidden></p>
            </div>
        </fieldset>

        {# -- Audio tags ----------------------------------------------------------- #}
        <fieldset class="settings-fieldset">
            <legend>Audio tags</legend>
            <label class="field-checkbox">
                <input type="checkbox" name="write_audio_tags" value="1" {{ client_config.writeAudioTags ? 'checked' : '' }}>
                <span>Fill missing audio tags</span>
            </label>
            <p class="form-note">
                Writes <strong>only missing</strong> embedded tags (series, narrator, author, …) into the
                downloaded audio files using tag-level edits — existing tags are never overwritten.
            </p>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save settings</button>
        </div>
    </form>

    {# -- Rewrite sidecars: its own form — it queues a job rather than saving settings. #}
    <form method="post" action="{{ path('settings_audiobooks_rewrite_sidecars') }}" class="settings-form">
        <input type="hidden" name="_token" value="{{ csrf_token('audiobooks_rewrite_sidecars') }}">
        <fieldset class="settings-fieldset">
            <legend>Rewrite sidecars</legend>
            <p class="form-note">
                Re-writes the sidecars beside every downloaded audiobook's folder, using
                Spine Scout's current stored metadata and cover. Runs in the background.
            </p>
            <button type="submit" class="btn btn-secondary">Rewrite all audiobook sidecars</button>
        </fieldset>
    </form>
{% endblock %}
