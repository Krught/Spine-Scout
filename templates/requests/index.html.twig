{% extends 'base.html.twig' %}

{% block title %}Requests - Spine Scout{% endblock %}

{% block body %}
    <section class="requests-section" data-controller="request-search requests-filter book-modal request-actions link-torrent"
             {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGE_SETTINGS') %}
             data-request-search-toggle-url-value="{{ path('requests_pipeline_toggle') }}"
             data-request-search-manual-next-url-value="{{ path('requests_manual_next') }}"
             data-request-search-token-value="{{ csrf_token('requests_pipeline') }}"
             {% endif %}>
        <header class="requests-header">
            <h1 class="requests-title">Requests</h1>

            {% if is_granted('ROLE_MANAGE_SETTINGS') or is_granted('ROLE_ADMIN') %}
                {% set automatic = automatic_fulfillment ?? true %}
                <div class="requests-header-controls">
                    {% if is_granted('ROLE_MANAGE_SETTINGS') %}
                        <label class="field-checkbox requests-pipeline-toggle">
                            <input type="checkbox"
                                   data-request-search-target="pipelineToggle"
                                   data-action="change->request-search#togglePipeline"
                                   {{ automatic ? 'checked' : '' }}>
                            <span>Automatic fulfillment</span>
                        </label>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <button type="button"
                                class="request-btn request-btn-search requests-queue-start"
                                data-request-search-target="queueStart"
                                data-action="click->request-search#startQueue"
                                {{ automatic ? 'hidden' : '' }}>Get next item</button>
                    {% endif %}
                </div>
            {% endif %}
        </header>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="requests-queue-notice" data-request-search-target="queueNotice" role="status" hidden></div>
        {% endif %}

        {% for label, messages in app.flashes %}
            {% for msg in messages %}
                <div class="flash flash-{{ label }}">{{ msg }}</div>
            {% endfor %}
        {% endfor %}

        {% if items is empty %}
            <div class="requests-empty">No requests yet.</div>
        {% else %}
            <div class="requests-filters" role="group" aria-label="Filter requests by status">
                {% for f in filters %}
                    <button type="button"
                            class="requests-filter{{ f.key == 'all' ? ' is-active' : '' }}"
                            data-requests-filter-target="chip"
                            data-status-key="{{ f.key }}"
                            data-action="requests-filter#select"
                            data-requests-filter-key-param="{{ f.key }}">
                        {{ f.label }} <span class="requests-filter-count">{{ f.count }}</span>
                    </button>
                {% endfor %}
            </div>

            {% if format_filters is not empty %}
                <div class="requests-filters requests-format-filters" role="group" aria-label="Filter requests by format">
                    {% for f in format_filters %}
                        <button type="button"
                                class="requests-filter{{ f.key == 'all' ? ' is-active' : '' }}"
                                data-requests-filter-target="formatChip"
                                data-format-key="{{ f.key }}"
                                data-action="requests-filter#selectFormat"
                                data-requests-filter-key-param="{{ f.key }}">
                            {{ f.label }} <span class="requests-filter-count">{{ f.count }}</span>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="requests-empty requests-filter-empty" data-requests-filter-target="empty" hidden>
                No requests match these filters.
            </div>

            <ul class="requests-list">
                {% for item in items %}
                    {{ include('requests/_row.html.twig', {item: item}) }}
                {% endfor %}
            </ul>

            {# Server-side pager. The status/format chips above filter the loaded page
               only, so their counts are page counts — the total lives here. #}
            {% if pages > 1 %}
                <nav class="requests-pager" aria-label="Requests pages">
                    {% if page > 1 %}
                        <a class="requests-pager-link" href="{{ path('requests', {page: page - 1}) }}" rel="prev">Prev</a>
                    {% else %}
                        <span class="requests-pager-link is-disabled" aria-disabled="true">Prev</span>
                    {% endif %}

                    <span class="requests-pager-status">
                        Page {{ page }} of {{ pages }}
                        <span class="requests-pager-total">{{ total }} request{{ total == 1 ? '' : 's' }}</span>
                    </span>

                    {% if page < pages %}
                        <a class="requests-pager-link" href="{{ path('requests', {page: page + 1}) }}" rel="next">Next</a>
                    {% else %}
                        <span class="requests-pager-link is-disabled" aria-disabled="true">Next</span>
                    {% endif %}
                </nav>
            {% endif %}
        {% endif %}

        {# Book detail popup, opened by clicking a request's cover/title. No interactive-search
           panel here (admins use the per-row button), so the modal's own Interactive Search
           button is hidden via CSS. #}
        <div class="book-modal" data-book-modal-target="modal" data-action="click->book-modal#backdropClick keydown.esc@window->book-modal#close interactive-search:downloaded@window->book-modal#onDownloaded" hidden>
            <div class="book-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="book-modal-title">
                <button type="button" class="book-modal-refresh" aria-label="Refresh metadata" title="Refresh metadata" data-book-modal-target="refresh" data-action="click->book-modal#refreshMetadata">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12a9 9 0 1 1-2.64-6.36"/>
                        <path d="M21 3v6h-6"/>
                    </svg>
                </button>
                <button type="button" class="book-modal-close" aria-label="Close" data-action="click->book-modal#close">×</button>
                <div class="book-modal-body">
                    <div class="book-modal-cover-wrap">
                        <div class="book-modal-cover" data-book-modal-target="cover"></div>
                        <button type="button" class="book-modal-action" data-book-modal-target="action" data-action="click->book-modal#requestBook" hidden></button>
                        <button type="button" class="book-modal-search" data-book-modal-target="search" data-action="click->book-modal#openSearch" hidden>Interactive Search</button>
                        <button type="button" class="book-modal-search book-modal-recommend" data-book-modal-target="recommend" data-action="click->book-modal#moreLikeThis" hidden>More like this</button>
                    </div>
                    <div class="book-modal-content">
                        <h2 class="book-modal-title" id="book-modal-title" data-book-modal-target="title"></h2>
                        <div class="book-modal-author" data-book-modal-target="author"></div>
                        <div class="book-modal-format" data-book-modal-target="format" hidden></div>
                        <div class="book-modal-status" data-book-modal-target="status">Loading…</div>
                        <dl class="book-modal-facts" data-book-modal-target="facts"></dl>
                        <div class="book-modal-genres" data-book-modal-target="genres"></div>
                        <div class="book-modal-description" data-book-modal-target="description"></div>
                    </div>
                </div>
            </div>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="book-modal request-search-overlay" data-request-search-target="overlay"
                 data-action="click->request-search#backdropClick" hidden>
                <div class="book-modal-dialog">
                    {# Queue chrome — only shown when the overlay was opened from the manual
                       queue ("Get next item"), never for the per-row search entry point.
                       Lives outside the shared panel so the panel stays reusable verbatim. #}
                    <div class="request-search-queue" data-request-search-target="queueBar" hidden>
                        <div class="request-search-queue-info">
                            <span class="request-search-queue-label">Manual queue</span>
                            <span class="request-search-queue-title" data-request-search-target="queueTitle"></span>
                        </div>
                        <div class="request-search-queue-actions">
                            <button type="button"
                                    class="request-btn request-search-queue-btn"
                                    data-request-search-target="skipButton"
                                    data-action="click->request-search#advance">Skip</button>
                            <button type="button"
                                    class="request-btn request-search-queue-btn request-search-queue-btn-next"
                                    data-request-search-target="nextButton"
                                    data-action="click->request-search#advance" hidden>Next item</button>
                        </div>
                    </div>
                    <div class="request-search-queue-done" data-request-search-target="queueDone" hidden>
                        <p class="request-search-queue-done-text">No requests waiting for manual search.</p>
                        <button type="button" class="request-btn"
                                data-action="click->request-search#close">Close</button>
                    </div>
                    {{ include('_interactive_search.html.twig') }}
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}
